# Copy to .env.prod, fill values, never commit the real file.

# Required.
OPENCLAW_GATEWAY_TOKEN=your-random-token-here-generate-with-openssl

# Required for migration.
# This host path currently contains the legacy container's /data directory.
OPENCLAW_DATA_DIR=/docker/openclaw-ylld/data

# Recommended for the first cutover.
OPENCLAW_LEGACY_CONTAINER=openclaw-ylld-openclaw-1

# Optional.
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:v2026.3.13-1

# Optional for interactive auth flows.
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# Optional API-key fallbacks.
# Preferred path: use `./ops/vps-deploy.sh auth-openai`.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
